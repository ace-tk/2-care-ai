# App Config
PROJECT_NAME="2Care AI"
ENV=development
DEBUG=true
API_V1_STR=/api/v1

# Server Config
HOST=0.0.0.0
PORT=8000

# Security (Change in production!)
SECRET_KEY=supersecretkeythatisatleast32characterslongforsecurity
ACCESS_TOKEN_EXPIRE_MINUTES=11520
ALGORITHM=HS256

# Database — local dev uses SQLite (no PostgreSQL required)
DATABASE_URL=sqlite+aiosqlite:///./twocare.db

# Production (Docker / hosted): use PostgreSQL instead
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/twocare

# CORS Settings (comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Voice & AI Services (Placeholders for transcription, reasoning, and speech synthesis)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Set false to skip ElevenLabs (text-only assistant responses; no 402 failures)
ENABLE_TTS=false
GROQ_API_KEY=your_groq_api_key_here

# Audio streaming settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024
